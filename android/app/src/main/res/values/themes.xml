<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, chromeless launch window; all colour is driven by Compose afterwards. -->
    <style name="Theme.Chron" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/chron_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>