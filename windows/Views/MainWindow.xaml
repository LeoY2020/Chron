<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chron.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.Background>
            <!-- 近黑底 + 顶部极淡高光，避免大面积纯黑显得发死 -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF16171B" Offset="0" />
                <GradientStop Color="#FF0A0A0C" Offset="0.28" />
                <GradientStop Color="#FF060607" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleDrag" Grid.Row="0" Background="Transparent" />
        <Grid x:Name="Host" Grid.Row="1" />
    </Grid>
</Window>
